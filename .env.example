# 模型：默认知乎直答（100 次/天，全租户共享），撞额度自动降级到下面的 claude 兼容端点
DEFAULT_PROVIDER=zhihu
ZHIHU_ACCESS_SECRET=
ZHIHU_ZHIDA_MODEL=zhida-fast-1p5

# 知乎 OAuth（App ID 为公开配置；App Key 为密钥，只填入 .env.local，不写进此文件）
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_REDIRECT_URI=

# 兜底模型：Anthropic 协议，可填官方或兼容中转站
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-5
